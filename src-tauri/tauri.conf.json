{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MediaBox",
  "version": "0.1.0",
  "identifier": "com.zkingz.reader",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "MediaBox",
        "width": 800,
        "height": 480,
        "minWidth": 240,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "visible": false,
        "titleBarStyle": "Transparent"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$EXE/**",
          "$APPDATA/**",
          "$HOME/**",
          "$DOWNLOAD/**",
          "$DOCUMENT/**",
          "$DESKTOP/**",
          "$VIDEO/**",
          "$PICTURE/**",
          "$RESOURCE/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../web-service-dist/**/*",
      "resources/shaders/**/*",
      "resources/libmpv/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese",
          "TradChinese",
          "English"
        ]
      }
    }
  }
}